APP_ENV=local
SMARTPARKING_LOCAL_API_KEY=local-dev-key
REQUIRE_API_KEY=true

# ローカルPythonからPostgreSQLへ接続する場合
DATABASE_URL=postgresql+psycopg://smartparking:change-me@localhost:5432/smartparking

# Docker Compose
POSTGRES_DB=smartparking
POSTGRES_USER=smartparking
POSTGRES_PASSWORD=change-me

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
TARGET_STALE_SECONDS=120
RUNTIME_ONLINE_SECONDS=5
COMMAND_LEASE_SECONDS=10
COMMAND_MAX_DELIVERIES=3
COMMAND_DEFAULT_LIFETIME_SECONDS=30
COMMAND_MIN_POLL_INTERVAL_SECONDS=0.5
MAX_EVENT_COUNT=50
MAX_EVENT_BYTES=1048576
MAX_SNAPSHOT_BYTES=5242880
