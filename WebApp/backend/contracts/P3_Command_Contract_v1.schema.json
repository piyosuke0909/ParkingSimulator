{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smart-parking.command-batch.schema.json",
  "title": "Smart Parking Command Batch v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractName",
    "schemaVersion",
    "serverTimeUtc",
    "leaseSeconds",
    "commands"
  ],
  "properties": {
    "contractName": {
      "const": "smart-parking.command-batch"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "serverTimeUtc": {
      "type": "string",
      "format": "date-time"
    },
    "leaseSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "commands": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractName",
        "schemaVersion",
        "commandId",
        "idempotencyKey",
        "commandType",
        "targetSourceId",
        "targetSessionId",
        "targetRunId",
        "createdAtUtc",
        "expiresAtUtc",
        "priority",
        "payload"
      ],
      "properties": {
        "contractName": {
          "const": "smart-parking.command"
        },
        "schemaVersion": {
          "const": "1.0"
        },
        "commandId": {
          "type": "string",
          "minLength": 1
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "commandType": {
          "const": "SET_AREA_POLICY"
        },
        "targetSourceId": {
          "type": "string",
          "minLength": 1
        },
        "targetSessionId": {
          "type": "string",
          "minLength": 1
        },
        "targetRunId": {
          "type": "string",
          "minLength": 1
        },
        "createdAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "priority": {
          "type": "integer"
        },
        "correlationId": {
          "type": "string"
        },
        "issuedBy": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/setAreaPolicyPayload"
        }
      }
    },
    "setAreaPolicyPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areaId",
        "policy"
      ],
      "properties": {
        "areaId": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "policy": {
          "type": "string",
          "enum": [
            "PRIORITY",
            "CLOSED",
            "RESTRICTED",
            "NORMAL"
          ]
        },
        "effectiveUntilUtc": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
