{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smart-parking.simulation-snapshot.v1.1.schema.json",
  "title": "Smart Parking Simulation Snapshot v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractName",
    "schemaVersion",
    "snapshotType",
    "snapshotId",
    "sourceSystem",
    "generatedAtUtc",
    "sceneName",
    "sessionId",
    "runId",
    "sequenceNumber",
    "scenario",
    "runtime",
    "summary",
    "activeScenarioFactors",
    "accessPoints",
    "areas",
    "parkingSlots",
    "vehicles"
  ],
  "properties": {
    "contractName": {
      "const": "smart-parking.simulation-snapshot"
    },
    "schemaVersion": {
      "const": "1.1"
    },
    "snapshotType": {
      "const": "simulation_snapshot"
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "sourceSystem": {
      "const": "unity"
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "sceneName": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "sequenceNumber": {
      "type": "integer",
      "minimum": 1
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "activeScenarioFactors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenarioFactor"
      }
    },
    "accessPoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/accessPoint"
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/area"
      }
    },
    "parkingSlots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parkingSlot"
      }
    },
    "vehicles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vehicle"
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "scenarioVersion",
        "scenarioName",
        "facilityId",
        "mapVersion",
        "timeOfDay",
        "randomSeed",
        "randomSeedPolicy",
        "simulationTimeSeconds",
        "durationSeconds",
        "isCompleted"
      ],
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "scenarioVersion": {
          "type": "string"
        },
        "scenarioName": {
          "type": "string"
        },
        "facilityId": {
          "type": "string",
          "minLength": 1
        },
        "mapVersion": {
          "type": "string"
        },
        "timeOfDay": {
          "type": "string"
        },
        "randomSeed": {
          "type": "integer"
        },
        "randomSeedPolicy": {
          "type": "string"
        },
        "simulationTimeSeconds": {
          "type": "number",
          "minimum": 0
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "isCompleted": {
          "type": "boolean"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arrivalRateSourceId",
        "arrivalDistribution",
        "baseVehiclesPerMinute",
        "arrivalRateMultiplier",
        "effectiveVehiclesPerMinute",
        "vehicleSpeedMultiplier",
        "activeVehicleCount",
        "discoveredVehicleCount",
        "maxConcurrentVehicles",
        "totalSpawnedCount"
      ],
      "properties": {
        "arrivalRateSourceId": {
          "type": "string",
          "minLength": 1
        },
        "arrivalDistribution": {
          "type": "string",
          "enum": [
            "poisson",
            "fixed",
            "custom"
          ]
        },
        "baseVehiclesPerMinute": {
          "type": "number",
          "minimum": 0
        },
        "arrivalRateMultiplier": {
          "type": "number",
          "minimum": 0
        },
        "effectiveVehiclesPerMinute": {
          "type": "number",
          "minimum": 0
        },
        "vehicleSpeedMultiplier": {
          "type": "number",
          "minimum": 0
        },
        "activeVehicleCount": {
          "type": "integer",
          "minimum": 0
        },
        "discoveredVehicleCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxConcurrentVehicles": {
          "type": "integer",
          "minimum": 0
        },
        "totalSpawnedCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalSlotCount",
        "availableSlotCount",
        "emptySlotCount",
        "reservedSlotCount",
        "occupiedSlotCount",
        "leavingSlotCount",
        "disabledSlotCount",
        "areaCount",
        "accessPointCount",
        "vehicleCount",
        "activeScenarioFactorCount"
      ],
      "properties": {
        "totalSlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "availableSlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "emptySlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "reservedSlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "occupiedSlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "leavingSlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "disabledSlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "areaCount": {
          "type": "integer",
          "minimum": 0
        },
        "accessPointCount": {
          "type": "integer",
          "minimum": 0
        },
        "vehicleCount": {
          "type": "integer",
          "minimum": 0
        },
        "activeScenarioFactorCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scenarioFactorEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioFactorEffectId",
        "targetType",
        "targetId",
        "resolvedTargetId",
        "metric",
        "operation",
        "value",
        "unit"
      ],
      "properties": {
        "scenarioFactorEffectId": {
          "type": "string"
        },
        "targetType": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "resolvedTargetId": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "scenarioFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioFactorId",
        "factorCode",
        "label",
        "category",
        "informationAvailability",
        "intensity",
        "startSimulationTimeSeconds",
        "endSimulationTimeSeconds",
        "hasKnownFromSimulationTimeSeconds",
        "knownFromSimulationTimeSeconds",
        "effects"
      ],
      "properties": {
        "scenarioFactorId": {
          "type": "string",
          "minLength": 1
        },
        "factorCode": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "informationAvailability": {
          "type": "string"
        },
        "intensity": {
          "type": "number",
          "minimum": 0
        },
        "startSimulationTimeSeconds": {
          "type": "number",
          "minimum": 0
        },
        "endSimulationTimeSeconds": {
          "type": "number",
          "minimum": 0
        },
        "hasKnownFromSimulationTimeSeconds": {
          "type": "boolean"
        },
        "knownFromSimulationTimeSeconds": {
          "type": "number",
          "minimum": 0
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenarioFactorEffect"
          }
        }
      }
    },
    "accessPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessPointId",
        "scenePairName",
        "entranceWaypointId",
        "exitWaypointId",
        "currentPreferenceWeight",
        "spawnPosition"
      ],
      "properties": {
        "accessPointId": {
          "type": "string",
          "minLength": 1
        },
        "scenePairName": {
          "type": "string"
        },
        "entranceWaypointId": {
          "type": "string"
        },
        "exitWaypointId": {
          "type": "string"
        },
        "currentPreferenceWeight": {
          "type": "number",
          "minimum": 0
        },
        "spawnPosition": {
          "$ref": "#/$defs/vector3"
        }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areaId",
        "sceneAreaId",
        "totalSlotCount",
        "availableSlotCount",
        "emptySlotCount",
        "reservedSlotCount",
        "occupiedSlotCount",
        "leavingSlotCount",
        "disabledSlotCount",
        "currentPreferenceWeight"
      ],
      "properties": {
        "areaId": {
          "type": "string",
          "minLength": 1
        },
        "sceneAreaId": {
          "type": "string"
        },
        "totalSlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "availableSlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "emptySlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "reservedSlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "occupiedSlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "leavingSlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "disabledSlotCount": {
          "type": "integer",
          "minimum": 0
        },
        "currentPreferenceWeight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "parkingSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotId",
        "areaId",
        "sceneAreaId",
        "state",
        "isAvailable",
        "sensorOccupied",
        "isLeaving",
        "reservedByVehicleId",
        "occupiedByVehicleId",
        "accessWaypointId",
        "position",
        "parkingPointPosition"
      ],
      "properties": {
        "slotId": {
          "type": "string",
          "minLength": 1
        },
        "areaId": {
          "type": "string",
          "minLength": 1
        },
        "sceneAreaId": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "Empty",
            "Reserved",
            "Occupied",
            "Leaving",
            "Disabled"
          ]
        },
        "isAvailable": {
          "type": "boolean"
        },
        "sensorOccupied": {
          "type": "boolean"
        },
        "isLeaving": {
          "type": "boolean"
        },
        "reservedByVehicleId": {
          "type": "string"
        },
        "occupiedByVehicleId": {
          "type": "string"
        },
        "accessWaypointId": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "parkingPointPosition": {
          "$ref": "#/$defs/vector3"
        }
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vehicleId",
        "objectName",
        "movementState",
        "isParked",
        "isStopped",
        "isStoppedByFrontVehicle",
        "stopReason",
        "entranceAccessPointId",
        "entranceScenePairName",
        "targetAreaId",
        "targetSceneAreaId",
        "targetSlotId",
        "currentAreaId",
        "currentSceneAreaId",
        "currentSlotId",
        "currentTargetWaypointId",
        "spawnSequenceNumber",
        "spawnedAtSimulationTimeSeconds",
        "currentSpeedMetersPerSecond",
        "position",
        "rotationEuler",
        "velocity"
      ],
      "properties": {
        "vehicleId": {
          "type": "string",
          "minLength": 1
        },
        "objectName": {
          "type": "string"
        },
        "movementState": {
          "type": "string"
        },
        "isParked": {
          "type": "boolean"
        },
        "isStopped": {
          "type": "boolean"
        },
        "isStoppedByFrontVehicle": {
          "type": "boolean"
        },
        "stopReason": {
          "type": "string"
        },
        "entranceAccessPointId": {
          "type": "string"
        },
        "entranceScenePairName": {
          "type": "string"
        },
        "targetAreaId": {
          "type": "string"
        },
        "targetSceneAreaId": {
          "type": "string"
        },
        "targetSlotId": {
          "type": "string"
        },
        "currentAreaId": {
          "type": "string"
        },
        "currentSceneAreaId": {
          "type": "string"
        },
        "currentSlotId": {
          "type": "string"
        },
        "currentTargetWaypointId": {
          "type": "string"
        },
        "spawnSequenceNumber": {
          "type": "integer",
          "minimum": 0
        },
        "spawnedAtSimulationTimeSeconds": {
          "type": "number",
          "minimum": 0
        },
        "currentSpeedMetersPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "rotationEuler": {
          "$ref": "#/$defs/vector3"
        },
        "velocity": {
          "$ref": "#/$defs/vector3"
        }
      }
    }
  }
}
